---
// Scripted walkthrough of tenant provisioning in the Helios console, built
// from real elements (no video). A fake cursor adds a tenant called
// "Department 33", it provisions, and the resource counts update.
// All data is fake. Designed on an 820x560 canvas and scaled to fit.
import DemoCursor from './DemoCursor.astro';
import { icon } from '../data/demoIcons';

const sideIcons = [
  'home',
  'layers',
  null,
  'stack',
  'download',
  'upload',
  null,
  'grid',
  'code',
  'stack',
  'upload',
  null,
  'building',
  'shield',
  'search',
  'panels',
  null,
  'book',
  'sync',
];
---

<div class="demo" data-demo="tenants">
  <div class="canvas" aria-hidden="true">
    <aside class="side">
      <span class="side-logo"></span>
      {
        sideIcons.map((name) =>
          name ? (
            <span class:list={['side-icon', { active: name === 'building' }]} set:html={icon(name)} />
          ) : (
            <span class="side-gap" />
          ),
        )
      }
    </aside>

    <header class="topbar">
      <span class="theme-toggle"><span>☀</span><span>☾</span></span>
      <span class="user"></span>
    </header>

    <section class="screen">
      <h2 class="page-title">Tenant Maintenance</h2>
      <p class="sub">Provision, inspect, and delete the tenants this server isolates data between.</p>

      <div class="stats">
        <div class="stat">
          <span class="label">TOTAL TENANTS</span>
          <strong data-total>1</strong>
          <span class="note" data-total-note>1 registered</span>
        </div>
        <div class="stat">
          <span class="label">RESOURCES STORED</span>
          <strong data-stored>13,213,630</strong>
          <span class="note" data-stored-note>across all tenants</span>
        </div>
      </div>

      <div class="panel">
        <div class="search-row">
          <span class="search">⌕ &nbsp;Search by name or tenant id…</span>
          <span class="btn-primary" data-add>+ Add Tenant</span>
        </div>
        <p class="counted" data-counted>Resources counted at 00:51:08 UTC.</p>
        <div class="table" data-table>
          <div class="tr th"><span>TENANT</span><span>RESOURCES</span><span>CREATED</span><span class="act">ACTIONS</span></div>
          <div class="tr" data-row="default">
            <span class="tenant"><i class="avatar">D</i><span><b>default</b><code>default</code></span></span>
            <span>13.21M</span>
            <span>2026-10-19</span>
            <span class="act">🗑</span>
          </div>
          <div class="tr new" data-row="new">
            <span class="tenant"><i class="avatar">D3</i><span><b>Department 33</b><code>department-33</code></span></span>
            <span class="res"><i class="spinner"></i><span data-new-res>Provisioning… this may take a moment.</span></span>
            <span data-new-created>—</span>
            <span class="act" data-new-act></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Add a Tenant -->
    <div class="modal-layer" data-modal>
      <div class="modal">
        <div class="modal-head"><strong>Add a Tenant</strong><span class="x">✕</span></div>
        <span class="field-label">Display name (optional)</span>
        <span class="input" data-name-input><span data-name class="placeholder">Acme Health</span><i class="caret"></i></span>
        <span class="hint">A human-friendly label; not used for routing.</span>
        <span class="field-label">Tenant id <em>*</em></span>
        <span class="input"><span data-id class="placeholder">acme-health</span></span>
        <span class="hint">Used in the API (X-Tenant-ID header, URL prefix, JWT claim).</span>
        <div class="modal-foot">
          <span class="btn-ghost">Cancel</span>
          <span class="btn-primary" data-provision>Provision Tenant</span>
        </div>
      </div>
    </div>

    <DemoCursor />
  </div>
</div>

<script>
  // Drives the walkthrough on the 820x560 canvas (see scripts/demo.ts).
  import { setupDemo, type DemoKit } from '../scripts/demo';

  const NAME = 'Department 33';
  const slug = (s: string) => s.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-');

  for (const demo of document.querySelectorAll<HTMLElement>('[data-demo="tenants"]')) {
    const $ = (sel: string) => demo.querySelector<HTMLElement>(sel)!;
    const table = $('[data-table]');
    const rowDefault = $('[data-row="default"]');
    const rowNew = $('[data-row="new"]');
    const name = $('[data-name]');
    const id = $('[data-id]');

    const setName = (text: string) => {
      name.textContent = text || 'Acme Health';
      id.textContent = text ? slug(text) : 'acme-health';
      name.classList.toggle('placeholder', !text);
      id.classList.toggle('placeholder', !text);
    };

    const reset = ({ pos }: DemoKit) => {
      $('[data-modal]').classList.remove('open');
      $('[data-name-input]').classList.remove('focus');
      setName('');
      table.insertBefore(rowNew, rowDefault); // new tenant appears on top
      rowNew.classList.remove('shown', 'ready');
      $('[data-new-res]').textContent = 'Provisioning… this may take a moment.';
      $('[data-new-created]').textContent = '—';
      $('[data-new-act]').textContent = '';
      $('[data-total]').textContent = '1';
      $('[data-total-note]').textContent = '1 registered';
      $('[data-stored]').textContent = '13,213,630';
      $('[data-stored-note]').textContent = 'across all tenants';
      $('[data-counted]').innerHTML = 'Resources counted at 00:51:08 UTC.';
      pos.x = 420;
      pos.y = 430;
    };

    const run = async ({ at, sleep, moveTo, click }: DemoKit, gen: number) => {
      await sleep(800, gen);

      // 1. Add Tenant
      const add = $('[data-add]');
      await moveTo(at(add), 1200, gen);
      await click(add, gen);
      $('[data-modal]').classList.add('open');
      await sleep(700, gen);

      // 2. Type the display name; the tenant id follows it
      const input = $('[data-name-input]');
      await moveTo(at(input, 0.3), 800, gen);
      await click(input, gen);
      input.classList.add('focus');
      await sleep(300, gen);
      for (let i = 1; i <= NAME.length; i++) {
        setName(NAME.slice(0, i));
        await sleep(85 + Math.random() * 60, gen);
      }
      await sleep(500, gen);

      // 3. Provision it
      const provision = $('[data-provision]');
      await moveTo(at(provision), 900, gen);
      await click(provision, gen);
      $('[data-modal]').classList.remove('open');
      rowNew.classList.add('shown');
      await moveTo({ x: 470, y: 470 }, 1000, gen);
      await sleep(1100, gen);

      // 4. Provisioned: totals start recounting
      table.appendChild(rowNew);
      rowNew.classList.add('ready');
      $('[data-new-res]').textContent = '–';
      $('[data-new-created]').textContent = '2026-10-22';
      $('[data-new-act]').textContent = '🗑';
      $('[data-total]').textContent = '2';
      $('[data-total-note]').textContent = '2 registered';
      $('[data-stored]').textContent = '—';
      $('[data-stored-note]').textContent = 'Counting…';
      $('[data-counted]').innerHTML = 'Updating resource counts; showing counts from 00:51:08 UTC. <u>Refresh</u>';
      await sleep(1800, gen);

      // 5. Counts arrive
      $('[data-stored]').textContent = '13,215,007';
      $('[data-stored-note]').textContent = 'across all tenants';
      $('[data-new-res]').textContent = '1.4K';
      $('[data-counted]').innerHTML = 'Resources counted at 00:51:35 UTC.';
      await sleep(3000, gen);
    };

    setupDemo(demo, { width: 820, reset, run });
  }
</script>

<style>
  .demo {
    position: relative;
    width: 100%;
    aspect-ratio: 820 / 560;
    overflow: hidden;
    font-family: var(--font-sans);
    color: #101010;
  }

  .canvas {
    position: absolute;
    left: 0;
    top: 0;
    width: 820px;
    height: 560px;
    transform-origin: 0 0;
    background: #f5f5f5;
    transition: opacity 0.6s ease;
  }

  .canvas.fade {
    opacity: 0;
  }

  code {
    font-family: var(--font-mono);
  }

  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      filter 0.15s ease;
  }

  .btn-primary {
    padding: 8px 13px;
    border-radius: 9px;
    background: #1b7fd6;
    color: #fff;
    font-weight: 500;
    font-size: 12.5px;
  }

  .btn-ghost {
    padding: 7px 12px;
    border: 1px solid #e4e4e4;
    border-radius: 8px;
    background: #fff;
    font-size: 12px;
  }

  .pressed {
    transform: scale(0.95);
    filter: brightness(0.95);
  }

  /* Sidebar + top bar */
  .side {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding-top: 12px;
    border-right: 1px solid #e8e8e8;
    background: #fafafa;
  }

  .side-logo {
    width: 30px;
    height: 30px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: url('/figma/orb.png') center / cover;
  }

  .side-gap {
    height: 8px;
  }

  .side-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 26px;
    border-radius: 8px;
    color: #4b4b4b;
  }

  .side-icon :global(svg) {
    width: 14px;
    height: 14px;
  }

  .side-icon.active {
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    color: #101010;
  }

  .topbar {
    position: absolute;
    left: 52px;
    right: 0;
    top: 0;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    padding-right: 20px;
  }

  .theme-toggle {
    display: flex;
    gap: 6px;
    padding: 3px 8px;
    border: 1px solid #e6e6e6;
    border-radius: 20px;
    background: #fff;
    font-size: 11px;
  }

  .user {
    width: 24px;
    height: 24px;
    border: 1px solid #e3e3e3;
    border-radius: 50%;
    background: #fff;
  }

  /* Page */
  .screen {
    position: absolute;
    left: 52px;
    right: 0;
    top: 44px;
    bottom: 0;
    padding: 2px 26px 0;
  }

  .page-title {
    font-weight: 600;
    font-size: 21px;
    letter-spacing: -0.02em;
  }

  .sub {
    margin-top: 3px;
    font-size: 11.5px;
    color: #707070;
  }

  .stats {
    display: flex;
    gap: 12px;
    margin-top: 14px;
  }

  .stat,
  .panel,
  .modal {
    border: 1px solid #e8e8e8;
    border-radius: 12px;
    background: linear-gradient(#fdfdfd, #f9f9f9);
    box-shadow: 0 3px 4px rgba(0, 0, 0, 0.03);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 196px;
    padding: 11px 14px;
  }

  .label {
    font-weight: 500;
    font-size: 9px;
    letter-spacing: 0.06em;
    color: #8a8a8a;
  }

  .stat strong {
    font-weight: 500;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .note {
    font-size: 10px;
    color: #8a8a8a;
  }

  .panel {
    margin-top: 14px;
    padding: 12px 14px 8px;
  }

  .search-row {
    display: flex;
    gap: 10px;
  }

  .search {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 0 11px;
    border: 1px solid #e6e6e6;
    border-radius: 9px;
    background: #fff;
    font-size: 12px;
    color: #9a9a9a;
  }

  .counted {
    margin: 9px 0 6px;
    font-size: 10.5px;
    color: #555;
  }

  .counted :global(u) {
    color: #1b7fd6;
  }

  .tr {
    display: grid;
    grid-template-columns: 2.2fr 2fr 1fr 0.6fr;
    align-items: center;
    min-height: 40px;
    padding: 0 6px;
    border-top: 1px solid #ededed;
    font-size: 11.5px;
  }

  .tr.th {
    min-height: 24px;
    border-top: 0;
    font-size: 9px;
    letter-spacing: 0.06em;
    color: #8a8a8a;
  }

  .act {
    text-align: right;
    font-size: 11px;
  }

  .tenant {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .tenant > span {
    display: flex;
    flex-direction: column;
  }

  .tenant b {
    font-weight: 500;
  }

  .tenant code {
    font-size: 10px;
    color: #777;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: #e2f3fe;
    font-style: normal;
    font-size: 8.5px;
    color: #1b7fd6;
  }

  .res {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #555;
  }

  /* The new tenant's row */
  .tr.new {
    display: none;
  }

  .tr.new.shown {
    display: grid;
    animation: row-in 0.5s ease both;
  }

  .tr.new.ready {
    animation: none;
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
      background: #e8f5fe;
    }
    60% {
      background: #e8f5fe;
    }
  }

  .ready .spinner {
    display: none;
  }

  .spinner {
    display: inline-block;
    width: 10px;
    height: 10px;
    border: 1.6px solid #cfe7f8;
    border-top-color: #33b8ff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Modal */
  .modal-layer {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    justify-content: center;
    padding-top: 150px;
    background: rgba(70, 70, 70, 0);
    pointer-events: none;
    transition: background 0.3s ease;
  }

  .modal-layer.open {
    background: rgba(70, 70, 70, 0.4);
  }

  .modal {
    display: flex;
    flex-direction: column;
    width: 300px;
    height: max-content;
    padding: 14px 16px;
    background: #fff;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transform: translateY(8px) scale(0.97);
    transition:
      opacity 0.25s ease,
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .open .modal {
    opacity: 1;
    transform: none;
  }

  .modal-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 13px;
  }

  .modal-head strong {
    font-weight: 600;
  }

  .x {
    font-size: 11px;
    color: #777;
  }

  .field-label {
    margin-top: 6px;
    font-size: 10.5px;
    color: #444;
  }

  .field-label em {
    font-style: normal;
    color: #d14343;
  }

  .input {
    display: flex;
    align-items: center;
    height: 30px;
    margin-top: 4px;
    padding: 0 10px;
    border: 1px solid #e3e3e3;
    border-radius: 8px;
    background: #fafafa;
    font-size: 12px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .input.focus {
    border-color: #33b8ff;
    box-shadow: 0 0 0 3px rgba(51, 184, 255, 0.18);
    background: #fff;
  }

  .placeholder {
    color: #9a9a9a;
  }

  .caret {
    display: none;
    width: 1px;
    height: 14px;
    margin-left: 1px;
    background: #101010;
    animation: blink 1s steps(1) infinite;
  }

  .focus .caret {
    display: block;
  }

  .focus .placeholder + .caret {
    order: -1;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hint {
    margin-top: 4px;
    font-size: 9.5px;
    color: #8a8a8a;
  }

  .modal-foot {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 12px;
  }

  .modal-foot .btn-primary {
    padding: 7px 12px;
    font-size: 12px;
  }
</style>
