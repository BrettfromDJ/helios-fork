<feGaussianBlur stdDeviation="27" result="effect1_foregroundBlur_ai-badge"/>
</filter>
<pattern id="pattern0_ai-badge" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_ai-badge" transform="scale(0.00680272 0.00689655)"/>
</pattern>
<pattern id="pattern1_ai-badge" patternContentUnits="objectBoundingBox" width="1" height="1">
