<g class="glow" opacity="0.67" filter="url(#filter0_f_ai-badge)">
<rect x="64.6238" y="65.5" width="128.752" height="127" fill="url(#pattern0_ai-badge)"/>
</g>
<rect class="orb" x="94.0239" y="94.5" width="69.9517" height="69" fill="url(#pattern1_ai-badge)"/>
<circle class="ripple" cx="129" cy="129" r="34.5" stroke="white" vector-effect="non-scaling-stroke"/>
