<clipPath id="clip0_ai-badge">
<rect width="16" height="16" fill="white" transform="translate(121 121.5)"/>
</clipPath>
<image id="image0_ai-badge" width="580" height="145" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>

<style>
  .ai-badge-svg {
    display: block;
    overflow: visible;
  }

  .ripple {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ripple {
      animation: ripple 3.6s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
    }

    .ripple-2 {
      animation-delay: 1.8s;
    }
  }

  @keyframes ripple {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    100% {
      transform: scale(2.3);
      opacity: 0;
    }
  }
</style>
