---
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'dark' | 'outline-dark' | 'outline-light';
  arrow?: boolean;
}

const { href, variant = 'primary', arrow = false } = Astro.props;
---

<a href={href} class:list={['button', variant]}>
  <slot />
  {arrow && <img src="/figma/arrow-right-white.svg" alt="" width="12" height="12" />}
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 24px;
    border-radius: var(--radius-button);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 16px;
    line-height: normal;
    white-space: nowrap;
    transition:
      filter 0.15s ease,
      background-color 0.15s ease;
  }

  .button:hover {
    filter: brightness(1.06);
  }

  .button:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .primary {
    background: var(--blue);
    color: var(--white);
  }

  .dark {
    background: var(--ink-deep);
    color: var(--white);
  }

  .outline {
    border: 1px solid rgba(160, 160, 160, 0.4);
    color: var(--ink-deep);
  }

  .outline-dark {
    border: 1px solid rgba(160, 160, 160, 0.4);
    color: var(--white);
  }

  .outline-light {
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: var(--white);
  }

  .outline:hover {
    background: rgba(0, 15, 23, 0.03);
  }

  .outline-dark:hover,
  .outline-light:hover {
    background: rgba(255, 255, 255, 0.06);
  }
</style>
