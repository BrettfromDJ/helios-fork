---
// The fake mouse pointer used by the scripted product walkthroughs.
// Moved and clicked by scripts/demo.ts.
---

<div class="cursor" data-cursor>
  <svg viewBox="0 0 24 24" width="26" height="26">
    <path d="M5 3l14 8-6.5 1.5L9.5 19z" fill="#0b0b0b" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"></path>
  </svg>
  <span class="ripple" data-ripple></span>
</div>

<style>
  .cursor {
    position: absolute;
    left: 0;
    top: 0;
    width: 26px;
    height: 26px;
    margin: -4px 0 0 -5px;
    pointer-events: none;
    z-index: 10;
    will-change: transform;
  }

  .cursor svg {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.25));
    transition: transform 0.12s ease;
  }

  .cursor.down svg {
    transform: scale(0.85);
  }

  .ripple {
    position: absolute;
    left: -11px;
    top: -10px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(51, 184, 255, 0.35);
    opacity: 0;
    transform: scale(0.3);
  }

  .ripple.go {
    animation: ripple 0.55s ease-out;
  }

  @keyframes ripple {
    0% {
      opacity: 0.9;
      transform: scale(0.3);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      display: none;
    }
  }
</style>
