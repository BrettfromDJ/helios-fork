---
// Full-width blue band with the animated brand glow behind centered content.
import GlowBackdrop from './GlowBackdrop.astro';

interface Props {
  id?: string;
  flipped?: boolean;
  padTop: number;
  padBottom: number;
}

const { id, flipped = false, padTop, padBottom } = Astro.props;
---

<section id={id} class="glow-band" style={`--pad-top: ${padTop}px; --pad-bottom: ${padBottom}px`}>
  <GlowBackdrop mirrored={!flipped} />
  <div class="container band-content">
    <slot />
  </div>
</section>

<style>
  .glow-band {
    position: relative;
    overflow: hidden;
    background: var(--blue-strong);
    color: var(--white);
    text-align: center;
  }

  .band-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--pad-top);
    padding-bottom: var(--pad-bottom);
  }
</style>
