---
// The Helios orb, stretched to fill its box. Used blurred as the soft glow
// behind feature cards; the caller sets position, size and blur.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['orb', className]} aria-hidden="true">
  <img src="/figma/orb.png" alt="" />
</div>

<style>
  .orb {
    position: absolute;
    overflow: hidden;
    pointer-events: none;
  }

  .orb img {
    width: 100%;
    height: 100%;
    max-width: none;
  }
</style>
