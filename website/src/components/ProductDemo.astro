---
// Scripted walkthrough of the Helios FHIR Server console, built from real
// elements (no video). A fake cursor hovers the Home chart, opens Resources,
// opens a Patient and scrolls its JSON, then opens the patient_addresses
// ViewDefinition, runs it and scrolls to the results table. All data is fake.
// Designed on a 1320x720 canvas and scaled to fit its container.

import DemoCursor from './DemoCursor.astro';
import { icon } from '../data/demoIcons';

const stats = [
  { label: 'RESOURCE TYPES', value: '27', note: 'used for R4' },
  { label: 'STORED RESOURCES', value: '19.0M', note: 'across active tenant' },
  { label: 'EXPORT JOBS', value: '0', note: 'running (0 queued)' },
  { label: 'IMPORT JOBS', value: '0', note: 'active' },
  { label: 'UPTIME', value: '5h 40m', note: 'since process start' },
];

// Chart: six series that jump from 0 to their totals on Oct 2
const series = [
  { name: 'Provenance', value: 11704, color: '#2fb2f2' },
  { name: 'Condition', value: 476422, color: '#7b61ff' },
  { name: 'CareTeam', value: 41419, color: '#22c55e' },
  { name: 'CarePlan', value: 41419, color: '#f59e0b' },
  { name: 'Immunization', value: 170475, color: '#e5487a' },
  { name: 'Encounter', value: 827919, color: '#8e95a3' },
];
const CHART_W = 1104;
const CHART_H = 250;
const Y_MAX = 900000;
const JUMP_FROM = 0.46;
const JUMP_TO = 0.495;
const y = (v: number) => CHART_H - (v / Y_MAX) * CHART_H;
const linePath = (v: number) =>
  `M0 ${y(0)} L${CHART_W * JUMP_FROM} ${y(0)} L${CHART_W * JUMP_TO} ${y(v)} L${CHART_W} ${y(v)}`;
const yTicks = [0, 225000, 450000, 675000, 900000];
const xTicks = [
  { label: 'SEP 17', at: 0 },
  { label: 'SEP 22', at: 0.166 },
  { label: 'SEP 28', at: 0.366 },
  { label: 'OCT 4', at: 0.566 },
  { label: 'OCT 10', at: 0.766 },
];

const recent = [
  { name: 'Patient', count: '11,704' },
  { name: 'ViewDefinition', count: '10' },
  { name: 'Observation', count: '7,699,881' },
  { name: 'NamingSystem', count: '0' },
  { name: 'NutritionOrder', count: '0' },
];
const allTypes = [
  ['Subscription', '0'],
  ['Substance', '0'],
  ['SubstanceNucleicAcid', '0'],
  ['SubstancePolymer', '0'],
  ['SubstanceProtein', '0'],
  ['SupplyDelivery', '337,768'],
  ['SupplyRequest', '0'],
  ['Task', '0'],
  ['TerminologyCapabilities', '0'],
];

const patients = [
  ['b7973a8d', 'Senger904, Brock407 Bruce167', '555-850-7291', 'male'],
  ['3dd31fcb', 'Wolff180, Toby274 Kermit56', '555-956-7234', 'male'],
  ['6ae01cd0', 'Mann644, Isaiah615 Antione404', '555-776-8471', 'male'],
  ['d8ab2c5c', 'Kunze215, Riley817 Mitch821', '555-202-8806', 'male'],
  ['6b0fe44e', 'Weimann465, Herb645', '555-419-8320', 'male'],
  ['4b3cb5e9', 'Johns824, Bertram873 Cyril535', '555-738-1714', 'male'],
  ['41178d1d', 'Kilback373, Emanuel231 Duane703', '555-938-8920', 'male'],
  ['cf3b93a0', 'Grimes165, Fransisca150 Maryann106', '555-375-4562', 'female'],
];

const viewDefs = [
  ['01a14569', 'observation_simple', '06:51 AM'],
  ['01a14546', 'observation_repeat_timeout', '08:13 AM'],
  ['01a0f080', 'patient_addresses', '10/2/2026'],
  ['01a0f072', 'us_core_blood_pressures', '10/2/2026'],
  ['01a0f06a', 'questionnaire_response_items', '10/2/2026'],
  ['01a0f069', 'patient_names_with_index', '10/2/2026'],
  ['01a0f068', 'patient_demographics', '10/2/2026'],
  ['01a0f087', 'patient_and_contact_addresses', '10/2/2026'],
  ['01a0f084', 'encounter_flat', '10/2/2026'],
  ['01a0f082', 'condition_flat', '10/2/2026'],
];

// Patient JSON, one entry per line: [indent, html]
const k = (s: string) => `<span class="jk">"${s}"</span>`;
const v = (s: string) => `<span class="js">"${s}"</span>`;
const patientJson: [number, string][] = [
  [0, '{'],
  [1, `${k('resourceType')}: ${v('Patient')},`],
  [1, `${k('id')}: ${v('b7973a8d-78eb-ac97-2f26-15c1b5b0d039')},`],
  [1, `${k('meta')}: {`],
  [2, `${k('profile')}: [`],
  [3, `${v('http://hl7.org/fhir/us/core/StructureDefinition/us-core-patient')}`],
  [2, '],'],
  [2, `${k('versionId')}: ${v('1')},`],
  [2, `${k('lastUpdated')}: ${v('2026-10-02T17:54:56.892Z')}`],
  [1, '},'],
  [1, `${k('text')}: {`],
  [2, `${k('status')}: ${v('generated')},`],
  [2, `${k('div')}: ${v('&lt;div xmlns=\\"http://www.w3.org/1999/xhtml\\"&gt;Generated by')}`],
  [1, '},'],
  [1, `${k('extension')}: [`],
  [2, '{'],
  [3, `${k('url')}: ${v('http://hl7.org/fhir/us/core/StructureDefinition/us-core-race')},`],
  [3, `${k('extension')}: [`],
  [4, '{'],
  [5, `${k('url')}: ${v('ombCategory')},`],
  [5, `${k('valueCoding')}: {`],
  [6, `${k('system')}: ${v('urn:oid:2.16.840.1.113883.6.238')},`],
  [6, `${k('code')}: ${v('2106-3')},`],
  [6, `${k('display')}: ${v('White')}`],
  [5, '}'],
  [4, '},'],
  [4, '{'],
  [5, `${k('url')}: ${v('text')},`],
  [5, `${k('valueString')}: ${v('White')}`],
  [4, '}'],
  [3, ']'],
  [2, '},'],
  [2, '{'],
  [3, `${k('url')}: ${v('http://hl7.org/fhir/us/core/StructureDefinition/us-core-birthsex')},`],
  [3, `${k('valueCode')}: ${v('M')}`],
  [2, '}'],
  [1, '],'],
  [1, `${k('identifier')}: [`],
  [2, '{'],
  [3, `${k('system')}: ${v('https://github.com/synthetichealth/synthea')},`],
  [3, `${k('value')}: ${v('b7973a8d-78eb-ac97-2f26-15c1b5b0d039')}`],
  [2, '}'],
  [1, '],'],
  [1, `${k('name')}: [`],
  [2, '{'],
  [3, `${k('use')}: ${v('official')},`],
  [3, `${k('family')}: ${v('Senger904')},`],
  [3, `${k('given')}: [${v('Brock407')}, ${v('Bruce167')}]`],
  [2, '}'],
  [1, '],'],
  [1, `${k('telecom')}: [`],
  [2, `{ ${k('system')}: ${v('phone')}, ${k('value')}: ${v('555-850-7291')} }`],
  [1, '],'],
  [1, `${k('gender')}: ${v('male')},`],
  [1, `${k('birthDate')}: ${v('1979-03-02')}`],
  [0, '}'],
];

const guidedFields = [
  { name: 'id', type: 'string', value: 'b7973a8d-78eb-ac97-2f26-15c1b5b0d039', note: 'Logical id of this artifact' },
  { name: 'versionId', type: 'id', value: '1', note: 'Version specific identifier', nested: true },
  { name: 'lastUpdated', type: 'instant', value: '2026-10-02T17:54:56.892Z', note: 'When the resource version last changed', nested: true },
  { name: '[0]', type: 'canonical', value: 'http://hl7.org/fhir/us/core/StructureDefinition/us-core-patient', note: 'Profiles this resource claims to conform to', nested: true },
  { name: 'status', type: 'code', value: 'generated', note: 'generated | extensions | additional | empty', nested: true },
  { name: 'div', type: 'xhtml', value: '<div xmlns="http://www.w3.org/1999/xhtml">Generated by', note: 'Limited xhtml content', nested: true },
  { name: 'url', type: 'uri', value: 'ombCategory', note: 'identifies the meaning of the extension', nested: true },
  { name: 'system', type: 'uri', value: 'urn:oid:2.16.840.1.113883.6.238', note: 'Identity of the terminology system', nested: true },
  { name: 'code', type: 'code', value: '2106-3', note: 'Symbol in syntax defined by the system', nested: true },
  { name: 'display', type: 'string', value: 'White', note: 'Representation defined by the system', nested: true },
];

const viewJson: [number, string][] = [
  [0, '{'],
  [1, `${k('resourceType')}: ${v('ViewDefinition')},`],
  [1, `${k('name')}: ${v('patient_addresses')},`],
  [1, `${k('status')}: ${v('draft')},`],
  [1, `${k('resource')}: ${v('Patient')},`],
  [1, `${k('select')}: [`],
  [2, `{ ${k('column')}: [{ ${k('path')}: ${v('getResourceKey()')}, ${k('name')}: ${v('resource_id')} }] },`],
  [2, '{'],
  [3, `${k('forEach')}: ${v('address')},`],
  [3, `${k('column')}: [`],
  [4, `{ ${k('path')}: ${v("line.join('\\n')")}, ${k('name')}: ${v('street')} },`],
  [4, `{ ${k('path')}: ${v('city')}, ${k('name')}: ${v('city')} },`],
  [4, `{ ${k('path')}: ${v('postalCode')}, ${k('name')}: ${v('zip')} },`],
  [4, `{ ${k('path')}: ${v('use')}, ${k('name')}: ${v('use')} }`],
  [3, ']'],
  [2, '}'],
  [1, ']'],
  [0, '}'],
];

const addressRows = [
  ['b7973a8d', '880 Kuhn Gardens', 'Boston', '02118', 'home'],
  ['3dd31fcb', '271 Bergnaum Way Apt 4', 'Cambridge', '02139', 'home'],
  ['6ae01cd0', '515 Hettinger Rapid', 'Worcester', '01604', 'home'],
  ['d8ab2c5c', '92 Ondricka Corner', 'Springfield', '01103', 'home'],
  ['6b0fe44e', '1043 Turcotte Street', 'Lowell', '01852', 'home'],
  ['4b3cb5e9', '377 Lynch Lodge Unit 12', 'Quincy', '02169', 'work'],
  ['41178d1d', '668 Bartell Crossing', 'Newton', '02458', 'home'],
  ['cf3b93a0', '154 Mraz Fork', 'Brockton', '02301', 'home'],
];

const sideIcons = [
  'home',
  'layers',
  'stack',
  'download',
  'upload',
  'grid',
  'code',
  'stack',
  'upload',
  'building',
  'shield',
  'search',
  'panels',
  'book',
  'sync',
];

---

<div class="demo" data-demo="console">
  <div class="canvas" aria-hidden="true">
    <!-- Sidebar -->
    <aside class="side">
      <span class="side-logo"></span>
      <span class="side-tenant">D</span>
      <nav class="side-icons">
        {
          sideIcons.map((name, i) => (
            <span class:list={['side-icon', { active: i === 0 }]} data-nav={i === 0 ? 'home' : i === 1 ? 'resources' : undefined} set:html={icon(name)} />
          ))
        }
      </nav>
    </aside>

    <!-- Top bar -->
    <header class="topbar">
      <span class="theme-toggle"><span class="sun">☀</span><span class="moon">☾</span></span>
      <span class="user"></span>
    </header>

    <!-- Home -->
    <section class="screen screen-home active" data-screen="home">
      <h2 class="page-title">Home</h2>
      <div class="stat-row">
        {
          stats.map((s) => (
            <div class="stat">
              <span class="label">{s.label}</span>
              <strong>{s.value}</strong>
              <span class="note">{s.note}</span>
            </div>
          ))
        }
      </div>
      <div class="chart-card">
        <div class="chart-head">
          <div>
            <span class="label">FHIR RESOURCES OVER TIME</span>
            <strong class="chart-total">1,569,358</strong>
            <span class="note">Provenance, Condition, CareTeam, CarePlan, Immunization, Encounter</span>
          </div>
          <div class="chart-controls">
            <span class="range"><span>1h</span><span>24h</span><span class="on">30d</span></span>
            <span class="series-select">Provenance +5 ⌄</span>
          </div>
        </div>
        <div class="chart" data-chart>
          <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} width={CHART_W} height={CHART_H} preserveAspectRatio="none">
            {yTicks.map((t) => <line x1="0" x2={CHART_W} y1={y(t)} y2={y(t)} class="grid" />)}
            {series.map((s) => <path d={linePath(s.value)} stroke={s.color} />)}
          </svg>
          {yTicks.map((t) => <span class="y-label" style={`top:${y(t) - 8}px`}>{t === 0 ? '0' : `${t / 1000}.0k`}</span>)}
          {xTicks.map((t) => <span class="x-label" style={`left:${t.at * CHART_W}px`}>{t.label}</span>)}
          <span class="guide" data-guide></span>
          <div class="tooltip" data-tooltip>
            <span class="tip-date" data-tip-date>OCT 6</span>
            {
              series.map((s) => (
                <span class="tip-row">
                  <i style={`background:${s.color}`} />
                  {s.name}
                  <b data-tip-value={s.value}>{s.value.toLocaleString('en-US')}</b>
                </span>
              ))
            }
          </div>
        </div>
        <div class="legend">
          {
            series.map((s) => (
              <span>
                <i style={`background:${s.color}`} />
                {s.name} <b>{s.value.toLocaleString('en-US')}</b>
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Resources -->
    <section class="screen screen-resources" data-screen="resources">
      <div class="res-head">
        <div>
          <h2 class="page-title">Resources</h2>
          <p class="sub">Browse, search, create, and edit FHIR resources. Search in natural language or build the query by hand, then open any result to edit it.</p>
        </div>
        <span class="btn-primary" data-create>+ Create new Patient</span>
      </div>
      <div class="res-body">
        <div class="types">
          <span class="mini-label">RESOURCE TYPES</span>
          <span class="filter">⌕ Filter types</span>
          <span class="mini-label">RECENTLY USED</span>
          <ul class="type-list">
            {
              recent.map((r, i) => (
                <li class:list={{ on: i === 0 }} data-type={r.name}>
                  {r.name}
                  <span>{r.count}</span>
                </li>
              ))
            }
          </ul>
          <span class="mini-label all">ALL TYPES</span>
          <ul class="type-list dim-list">
            {
              allTypes.map(([n, c]) => (
                <li>
                  {n}
                  <span>{c}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="res-main">
          <div class="search-card">
            <div class="mode-tabs"><span class="on">✦ Natural language</span><span>▦ Visual builder</span></div>
            <div class="nl-row">
              <span class="nl-input">✦ &nbsp;Describe what you're looking for — e.g. patients named Smith born after 1980</span>
              <span class="btn-primary small">⌕ Search</span>
            </div>
            <p class="fine">Your text and this server's search parameters go to the language model. Patient data never does.</p>
            <div class="chips">
              <span>Female patients over 65 with a diabetes diagnosis</span>
              <span>Observations from the last 30 days, most recent first</span>
              <span>Encounters at Boston General still in progress</span>
            </div>
            <div class="query-row">
              <span class="query-tag">&lt;&gt; QUERY</span>
              <code class="query" data-query>GET /Patient?_summary=true</code>
              <span class="btn-ghost">Recent</span>
              <span class="btn-primary small">Run</span>
            </div>
            <p class="plain"><span>IN PLAIN ENGLISH</span> <em data-plain>Find Patient records.</em></p>
          </div>

          <div class="results-card">
            <!-- Patients -->
            <div class="results results-patients active" data-results="Patient">
              <div class="results-head"><b>RESULTS</b> 11,704 results <span class="sort">SORT &nbsp; Default ⌄</span></div>
              <div class="table pt">
                <div class="tr th"><span>ID</span><span>IDENTIFIER</span><span>NAME</span><span>TELECOM</span><span>GENDER</span></div>
                {
                  patients.map(([id, name, phone, g], i) => (
                    <div class="tr" data-patient={i === 0 ? 'first' : undefined}>
                      <span><code>{id}</code></span>
                      <span class="trunc">{'{"system":"https://github.com/syntheti…'}</span>
                      <span>{name}</span>
                      <span class="trunc">{`{"system":"phone","value":"${phone}"…`}</span>
                      <span>{g}</span>
                    </div>
                  ))
                }
              </div>
            </div>
            <!-- ViewDefinitions -->
            <div class="results results-views" data-results="ViewDefinition">
              <div class="results-head"><b>RESULTS</b> 10 results <span class="sort">SORT &nbsp; Default ⌄</span></div>
              <div class="table vd">
                <div class="tr th"><span>ID</span><span>NAME</span><span>STATUS</span><span>UPDATED</span></div>
                {
                  viewDefs.map(([id, name, updated]) => (
                    <div class="tr" data-view={name}>
                      <span><code>{id}</code></span>
                      <span>{name}</span>
                      <span>draft</span>
                      <span>{updated}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Patient editor -->
    <div class="modal-layer" data-modal="patient">
      <div class="modal">
        <div class="modal-head">
          <div>
            <strong>Edit Resource</strong>
            <code>Patient/b7973a8d-78eb-ac97-2f26-15c1b5b0d039</code>
          </div>
          <span class="tabs"><span class="on">Edit</span><span>History</span></span>
          <span class="spacer"></span>
          <span class="btn-ghost">Delete</span>
          <span class="btn-primary small">Save Changes</span>
          <span class="close" data-close>✕</span>
        </div>
        <div class="modal-body two">
          <div class="pane">
            <div class="pane-head"><b>&lt;&gt; JSON</b><span class="pill">Collapse all</span><span class="pill">Expand all</span><span class="spacer"></span><span class="pill">Edit raw</span></div>
            <div class="pane-scroll" data-json-pane>
              <div class="code" data-scroll="json">
                {
                  patientJson.map(([ind, html], i) => (
                    <div class="ln">
                      <span class="no">{i + 1}</span>
                      <span class="src" style={`padding-left:${ind * 17}px`} set:html={html} />
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
          <div class="pane">
            <div class="pane-head"><b>⚙ Guided form</b><span class="spacer"></span><span class="ok">No issues.</span></div>
            <div class="pane-scroll">
              <div class="form" data-scroll="form">
                <p class="check">● Checked as you type: structure, cardinality, required bindings</p>
                <p class="check muted">◌ Checked on save: constraints and terminology</p>
                <p class="form-title">Patient <code>Patient</code></p>
                {
                  guidedFields.map((f) => (
                    <div class:list={['field', { nested: f.nested }]}>
                      <span class="fname">
                        {f.name} <code>{f.type}</code>
                      </span>
                      <span class="fvalue">{f.value}</span>
                      <span class="fx">✕</span>
                      <span class="fnote">{f.note}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ViewDefinition editor + results -->
    <div class="modal-layer" data-modal="view">
      <div class="modal">
        <div class="modal-head">
          <div>
            <strong>patient_addresses</strong>
            <code>ViewDefinition/01a0f080-d2e4-7f32-b57d-17008cfb8722</code>
          </div>
          <span class="tabs"><span class="on">Edit</span><span>History</span></span>
          <span class="spacer"></span>
          <span class="btn-ghost">Delete</span>
          <span class="btn-run" data-run>▶ Run view</span>
          <span class="close">✕</span>
        </div>
        <div class="modal-body one" data-view-body>
          <div class="view-scroll" data-scroll="view">
            <div class="pane view-json">
              <div class="pane-head"><b>&lt;&gt; JSON</b><span class="pill">Collapse all</span><span class="pill">Expand all</span></div>
              <div class="code">
                {
                  viewJson.map(([ind, html], i) => (
                    <div class="ln">
                      <span class="no">{i + 1}</span>
                      <span class="src" style={`padding-left:${ind * 17}px`} set:html={html} />
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="pane view-results" data-view-results>
              <div class="pane-head">
                <b>▦ Results</b>
                <span class="rows-note" data-rows-note>Run the view to see rows</span>
                <span class="spacer"></span>
                <span class="pill">CSV</span><span class="pill">NDJSON</span><span class="pill">Parquet</span>
              </div>
              <div class="table ad">
                <div class="tr th"><span>RESOURCE_ID</span><span>STREET</span><span>CITY</span><span>ZIP</span><span>USE</span></div>
                {
                  addressRows.map((r, i) => (
                    <div class="tr row-in" style={`--i:${i}`}>
                      {r.map((c, j) => (j === 0 ? <span><code>{c}</code></span> : <span>{c}</span>))}
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <DemoCursor />
  </div>
</div>

<script>
  // Drives the walkthrough on the 1320x720 canvas (see scripts/demo.ts).
  import { setupDemo, type DemoKit } from '../scripts/demo';

  for (const demo of document.querySelectorAll<HTMLElement>('[data-demo="console"]')) {
    const chart = demo.querySelector<HTMLElement>('[data-chart]')!;
    const guide = demo.querySelector<HTMLElement>('[data-guide]')!;
    const tooltip = demo.querySelector<HTMLElement>('[data-tooltip]')!;
    const tipDate = demo.querySelector<HTMLElement>('[data-tip-date]')!;
    const tipValues = [...demo.querySelectorAll<HTMLElement>('[data-tip-value]')];

    const show = (screen: string) => {
      demo.querySelectorAll('[data-screen]').forEach((s) => s.classList.toggle('active', (s as HTMLElement).dataset.screen === screen));
      demo.querySelectorAll('[data-nav]').forEach((n) => n.classList.toggle('active', (n as HTMLElement).dataset.nav === screen));
    };

    // Chart hover: guide + tooltip follow the cursor over the chart
    const DAY0 = new Date(Date.UTC(2026, 8, 16));
    const fmt = (d: Date) => d.toLocaleString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }).toUpperCase();
    const onMove = ({ $, at, pos }: DemoKit) => {
      if (!$('[data-screen="home"]').classList.contains('active')) return;
      const c = at(chart, 0, 0);
      const x = pos.x - c.x;
      const inside = x >= 0 && x <= 1104 && pos.y >= c.y && pos.y <= c.y + 250;
      chart.classList.toggle('hovering', inside);
      if (!inside) return;
      guide.style.transform = `translateX(${x}px)`;
      tooltip.style.transform = `translate(${Math.min(x + 18, 1104 - 230)}px, 20px)`;
      const frac = x / 1104;
      const day = new Date(DAY0.getTime() + Math.round(frac * 30) * 86400000);
      tipDate.textContent = fmt(day);
      const k = Math.max(0, Math.min(1, (frac - 0.46) / (0.495 - 0.46)));
      tipValues.forEach((el) => {
        el.textContent = Math.round(Number(el.dataset.tipValue) * k).toLocaleString('en-US');
      });
    };

    const scrollTo = (sel: string, px: number) => {
      demo.querySelector<HTMLElement>(sel)!.style.transform = `translateY(${-px}px)`;
    };

    const reset = ({ $, pos }: DemoKit) => {
      show('home');
      chart.classList.remove('hovering');
      demo.querySelectorAll('[data-modal]').forEach((m) => m.classList.remove('open'));
      demo.querySelectorAll('[data-type]').forEach((t) => t.classList.toggle('on', (t as HTMLElement).dataset.type === 'Patient'));
      demo.querySelectorAll('[data-results]').forEach((r) => r.classList.toggle('active', (r as HTMLElement).dataset.results === 'Patient'));
      $('[data-query]').textContent = 'GET /Patient?_summary=true';
      $('[data-plain]').textContent = 'Find Patient records.';
      $('[data-create]').textContent = '+ Create new Patient';
      $('[data-view-results]').classList.remove('loaded', 'loading');
      $('[data-rows-note]').textContent = 'Run the view to see rows';
      ['[data-scroll="json"]', '[data-scroll="form"]', '[data-scroll="view"]'].forEach((s) => scrollTo(s, 0));
      pos.x = 980;
      pos.y = 640;
    };

    const run = async ({ $, at, sleep, moveTo, click }: DemoKit, gen: number) => {
      await sleep(700, gen);

      // 1. Hover across the chart
      const chartTop = at(chart, 0, 0);
      await moveTo({ x: chartTop.x + 380, y: chartTop.y + 150 }, 900, gen);
      await moveTo({ x: chartTop.x + 640, y: chartTop.y + 70 }, 1300, gen);
      await moveTo({ x: chartTop.x + 930, y: chartTop.y + 60 }, 1700, gen, (t) => t);
      await sleep(1400, gen);

      // 2. Open Resources from the sidebar
      const navRes = $('[data-nav="resources"]');
      await moveTo(at(navRes), 1100, gen);
      await click(navRes, gen);
      chart.classList.remove('hovering');
      show('resources');
      await sleep(1100, gen);

      // 3. Open a patient and scroll their record
      const row = $('[data-patient="first"]');
      await moveTo(at(row, 0.42), 1000, gen);
      row.classList.add('hover');
      await click(row, gen);
      row.classList.remove('hover');
      $('[data-modal="patient"]').classList.add('open');
      await sleep(900, gen);
      await moveTo(at($('[data-json-pane]'), 0.45, 0.55), 800, gen);
      scrollTo('[data-scroll="json"]', 520);
      scrollTo('[data-scroll="form"]', 260);
      await sleep(3000, gen);
      const close = $('[data-close]');
      await moveTo(at(close), 900, gen);
      await click(close, gen);
      $('[data-modal="patient"]').classList.remove('open');
      await sleep(600, gen);

      // 4. Switch to ViewDefinitions
      const vdType = $('[data-type="ViewDefinition"]');
      await moveTo(at(vdType, 0.3), 1000, gen);
      await click(vdType, gen);
      demo.querySelectorAll('[data-type]').forEach((t) => t.classList.toggle('on', t === vdType));
      demo.querySelectorAll('[data-results]').forEach((r) => r.classList.toggle('active', (r as HTMLElement).dataset.results === 'ViewDefinition'));
      $('[data-query]').textContent = 'GET /ViewDefinition?_summary=true';
      $('[data-plain]').textContent = 'Find ViewDefinition records.';
      $('[data-create]').textContent = '+ Create new ViewDefinition';
      await sleep(900, gen);

      // 5. Open patient_addresses, run it, scroll to the table
      const vdRow = $('[data-view="patient_addresses"]');
      await moveTo(at(vdRow, 0.4), 1000, gen);
      vdRow.classList.add('hover');
      await click(vdRow, gen);
      vdRow.classList.remove('hover');
      $('[data-modal="view"]').classList.add('open');
      await sleep(1000, gen);
      const runBtn = $('[data-run]');
      await moveTo(at(runBtn), 1000, gen);
      await click(runBtn, gen);
      const results = $('[data-view-results]');
      results.classList.add('loading');
      $('[data-rows-note]').textContent = 'Running…';
      await sleep(700, gen);
      results.classList.remove('loading');
      results.classList.add('loaded');
      $('[data-rows-note]').textContent = '8 rows · 41 ms';
      await moveTo(at($('[data-view-body]'), 0.55, 0.6), 700, gen);
      scrollTo('[data-scroll="view"]', 330);
      await sleep(3600, gen);
    };

    setupDemo(demo, { width: 1320, reset, run, onMove });
  }
</script>

