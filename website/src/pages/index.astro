---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import StatsStrip from '../components/StatsStrip.astro';
import GlowBand from '../components/GlowBand.astro';
import AiBadge from '../components/AiBadge.astro';
import { BOOK_CALL, GITHUB } from '../data/site';

const stats = [
  'Live in 2,000+ clinics, integrated with seven EMRs',
  'Open-source FHIR server, written in Rust, free on GitHub',
  'Founded 2016, Boston',
];

const steps = [
  { n: '01', text: 'Book a thirty-minute call with our founder and lead engineer, Steve.' },
  { n: '02', text: 'We’ll discuss your project and how we can help.' },
  { n: '03', text: 'If it’s a fit, we’ll put a plan in writing and get to work.' },
];
---

<Layout>
    <!-- Hero -->
    <section class="hero container" data-stagger>
      <p class="eyebrow">MEET HELIOS</p>
      <h1 class="heading-xl">
        <span class="dim">We build the healthcare software</span>{' '}you can’t afford to get wrong
      </h1>
      <p class="body-lg hero-lede">
        A senior engineering firm for healthcare technology leaders. We architected the platform
        behind one of the most widely deployed SMART on FHIR applications in the country.
      </p>
      <div class="actions actions-center">
        <Button href={BOOK_CALL} arrow>Book a call</Button>
        <Button href="#case-studies" variant="outline">See our work</Button>
      </div>

      <div class="hero-stats">
        <StatsStrip items={stats} cellWidth={290} />
      </div>
    </section>

    <!-- Problem statement -->
    <section class="statement rule-top">
      <div class="container" data-stagger>
        <span class="marker" aria-hidden="true"></span>
        <h2 class="heading-lg statement-text">
          <span class="dim">Healthcare technology leaders are being asked to</span>{' '}deliver more
          innovative software, adopt AI, and protect patient data, without drowning.
        </h2>
      </div>
    </section>

    <!-- Services -->
    <section class="services">
      <div class="container services-grid" data-stagger>
        <article class="card service-card lift-on-hover">
          <img class="mockup hover-lift" src="/figma/search-mockup.png" alt="" width="493" height="489" loading="lazy" />
          <div class="service-copy">
            <h3>Software that makes it to production</h3>
            <p>
              We build new healthcare software and rescue what’s stalled. Systems that hold up
              under real patient data, delivered by engineers who have done it at scale.
            </p>
            <Button href={BOOK_CALL} arrow>Book a call</Button>
          </div>
        </article>

        <article class="card service-card lift-on-hover">
          <div class="ai-badge hover-lift" aria-hidden="true">
            <AiBadge />
          </div>
          <div class="service-copy">
            <h3>AI, put to work</h3>
            <p class="wide">
              We help healthcare organizations move AI from pilot to production: scoping where it
              holds up in clinical work, then building it into the systems your teams already use.
            </p>
            <Button href={BOOK_CALL} arrow>Book a call</Button>
          </div>
        </article>
      </div>
    </section>

    <!-- Case study -->
    <section id="case-studies" class="case container">
      <div class="case-head">
        <div data-reveal>
          <h2 class="heading-lg case-title">
            <span class="dim-ink">From FHIR Strategy</span>{' '}to Production
          </h2>
          <p class="body-lg case-lede">
            For a prominent diagnostics company, we helped set the FHIR implementation strategy,
            staffed the initial engineering team, and did the hands-on development for a product
            that today runs in more than 2,000 clinics and is integrated with seven EMRs.
          </p>
        </div>
        <p class="big-stat" data-reveal data-delay="150">
          <span class="big-number"><span data-count="2000">2,000</span>+</span>
          <span class="big-label">Clinics</span>
        </p>
      </div>

      <div class="case-grid" data-stagger>
        <figure class="card testimonial">
          <blockquote>
            "Helios has transformed our clinic's operations. With seamless integration into our
            existing systems, we now serve over 2,000 patients daily without a hitch. The AI-driven
            insights have improved our patient care and streamlined workflows. We couldn't be
            happier with the results!"
          </blockquote>
          <figcaption>Dr. Sarah Thompson, Chief Medical Officer</figcaption>
        </figure>

        <!-- The image includes its own card corners, shadow and glow -->
        <div class="photo">
          <img
            src="/figma/clinician.jpg"
            alt="A clinician at his desk reviewing work on a laptop"
            width="652"
            height="371"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="how rule-top">
      <div class="container">
        <h2 class="heading-lg" data-reveal>How it works</h2>
        <ol class="steps" data-stagger="100">
          {
            steps.map((s) => (
              <li>
                <span class="step-number">{s.n}</span>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- CTA: what it looks like when it works -->
    <GlowBand padTop={103} padBottom={102}>
        <h2 class="heading-lg">What it looks like when it works</h2>
        <p class="band-text works-text">
          The software is live. Clinicians use it without thinking about it, the integration holds
          through the next EHR upgrade, and the next board meeting opens with a demo of what's
          running and what customers are saying.
        </p>
        <Button href={BOOK_CALL} variant="dark" arrow>Book a call</Button>
    </GlowBand>

    <!-- Production -->
    <section class="split split-section container" data-stagger>
      <h2 class="heading-lg split-title">
        <span class="dim-light">Most healthcare software looks fine</span>{' '}in a demo.
      </h2>
      <p class="body-lg split-text">
        Production is where it gets hard: real patient data, clinical workflows that cannot pause
        for a bug, security review, integration engines nobody wants to touch. That is the
        environment we build for, and it is where our references come from. We made UTSW's
        VitalSign⁶ fully SMART on FHIR compatible, working directly with their team. When a client
        needed a working FHIR application for a major public demonstration, we delivered the first
        version in time. If your organization is carrying software it cannot afford to get wrong,
        we should talk.
      </p>
    </section>

    <section class="container">
      <figure class="card quote" data-reveal="zoom">
        <div class="quote-glow" aria-hidden="true">
          <span class="glow-main"></span>
          <span class="glow-soft"></span>
        </div>
        <blockquote class="heading-lg">
          <span class="dim-ink">“Healthcare's most valuable data has been sitting unused for decades.</span>{' '}That just changed.”
        </blockquote>
      </figure>
    </section>

    <!-- Open source -->
    <section id="open-source" class="open-source">
      <div class="container">
        <div class="split split-dark" data-stagger>
          <div>
            <h2 class="heading-lg">
              <span class="dim-white">We build</span>{' '}in the open.
            </h2>
            <div class="actions">
              <Button href={GITHUB} arrow>View on Github</Button>
              <Button href={GITHUB} variant="outline-dark">Explore the server</Button>
            </div>
          </div>
          <p class="body-lg split-text">
            The Helios FHIR Server is our open-source implementation of the HL7® FHIR® standard,
            written in Rust for performance and built for clinical analytics at scale. It supports
            FHIR R4 through R6 in a single system, with complete FHIRPath and SQL-on-FHIR engines,
            and deploys anywhere from a laptop to a production cluster. It is free, MIT-licensed,
            and public on GitHub.
          </p>
        </div>

        <div class="terminal" data-reveal="zoom">
          <div class="terminal-bar">
            <img src="/figma/terminal-dots.svg" alt="" width="32" height="8" />
            <span>[FHIR SERVER DEMO CAPTURE]</span>
          </div>
          <div class="terminal-body">
            <code><span class="prompt">$ </span><span class="typed">docker run -p 8080:8080 ghcr.io/heliossoftware/hfs:latest</span></code>
            <div class="terminal-lines" aria-hidden="true">
              <span style="width: 456px"></span>
              <span style="width: 579px"></span>
              <span style="width: 338px"></span>
              <span style="width: 579px"></span>
              <span style="width: 338px"></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA: what we put into production -->
    <GlowBand id="book-a-call" flipped padTop={121} padBottom={120}>
        <img class="band-orb" src="/figma/orb.png" alt="" width="61" height="60" />
        <h2 class="heading-lg answer-title">
          <span class="dim-soft">What we put into production,</span>{' '}we answer for.
        </h2>
        <p class="band-text answer-text">
          We take a small number of engagements at a time. Thirty minutes with Steve will tell you
          whether we can help.
        </p>
        <Button href={BOOK_CALL} variant="dark" arrow>Book a call</Button>
    </GlowBand>

</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-top: 98px;
    padding-bottom: 80px;
    text-align: center;
  }

  .hero .eyebrow {
    margin-bottom: 24px;
  }

  .hero h1 {
    max-width: 624px;
    margin: 0 auto;
  }

  .hero-lede {
    max-width: 491px;
    margin: 24px auto;
  }

  .hero-stats {
    margin-top: 85px;
  }

  /* ---------- Statement ---------- */
  .statement .container {
    padding-top: 59px;
    padding-bottom: 80px;
  }

  .statement-text {
    max-width: 781px;
    margin-top: 24px;
  }

  /* ---------- Services ---------- */
  .services {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    padding-top: 79px;
    padding-bottom: 79px;
  }

  .service-copy p.wide {
    max-width: 423px;
  }

  .mockup {
    position: absolute;
    top: 37px;
    left: 71.3%;
    width: 493px;
    max-width: none;
  }

  .ai-badge {
    position: absolute;
    right: 29px;
    bottom: 20px;
    width: 139px;
    height: 137px;
  }

  /* The badge artwork extends past the outer ring for its glow */
  .ai-badge :global(.ai-badge-svg) {
    position: absolute;
    left: -59.5px;
    top: -60.5px;
    width: 258px;
    height: 258px;
    max-width: none;
  }

  /* ---------- Case study ---------- */
  .case {
    padding-top: 60px;
    padding-bottom: 80px;
  }

  .case-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
  }

  .case-title {
    max-width: 426px;
    margin-top: 42px;
  }

  .case-lede {
    max-width: 531px;
    margin-top: 18px;
  }

  .big-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .big-number {
    font-weight: 500;
    font-size: clamp(88px, 12.8vw, 184px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .big-label {
    margin-top: -25px;
    font-size: clamp(24px, 2.43vw, 35px);
    line-height: 24px;
    letter-spacing: -0.02em;
    color: var(--muted);
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 32px;
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-height: 363px;
    padding: 39px;
    background: linear-gradient(to bottom, var(--white), var(--tint));
  }

  .testimonial blockquote {
    margin: 0;
    max-width: 491px;
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .testimonial figcaption {
    font-size: 17px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: rgba(16, 16, 16, 0.36);
  }

  /* The image has 4px of shadow margin on each side, so pull it out to line
     its card up with the testimonial */
  .photo img {
    width: calc(100% + 8px);
    max-width: none;
    height: auto;
    margin: -4px;
  }

  /* ---------- How it works ---------- */
  .how .container {
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .steps {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .step-number {
    display: block;
    font-size: clamp(80px, 8.4vw, 121px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--blue);
  }

  .steps p {
    max-width: 364px;
    margin-top: 27px;
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  /* ---------- Gradient bands ---------- */
  .band-text {
    font-size: 18px;
    line-height: 24px;
    letter-spacing: -0.02em;
  }

  .works-text {
    max-width: 458px;
    margin: 24px 0;
  }

  .band-orb {
    width: 61px;
    height: 60px;
    margin-bottom: 16px;
  }

  .answer-title {
    max-width: 600px;
  }

  .answer-text {
    max-width: 491px;
    margin: 16px 0;
  }

  /* ---------- Split sections ---------- */
  .split {
    display: flex;
    justify-content: space-between;
    gap: 48px;
  }

  .split-section {
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .split-title {
    max-width: 491px;
  }

  .split-text {
    max-width: 578px;
  }

  .quote {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 363px;
    padding: 40px;
    background: linear-gradient(to bottom, var(--white), var(--tint));
    box-shadow: none;
    text-align: center;
  }

  .quote blockquote {
    position: relative;
    margin: 0;
    max-width: 629px;
  }

  /* Warm yellow light from the top-right corner over the pale blue fade,
     colors sampled from the design; it drifts and breathes slowly */
  .quote-glow {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .quote-glow span {
    position: absolute;
    border-radius: 50%;
    filter: blur(30px);
  }

  .glow-main {
    right: -26%;
    top: -70%;
    width: 66%;
    height: 160%;
    background: radial-gradient(
      closest-side,
      rgba(253, 222, 128, 0.95),
      rgba(253, 228, 150, 0.55) 45%,
      rgba(253, 236, 180, 0)
    );
  }

  .glow-soft {
    right: -8%;
    top: 30%;
    width: 48%;
    height: 110%;
    background: radial-gradient(closest-side, rgba(244, 236, 196, 0.8), rgba(244, 236, 196, 0));
  }

  @media (prefers-reduced-motion: no-preference) {
    .glow-main {
      animation: quote-glow-main 10s ease-in-out infinite alternate;
    }

    .glow-soft {
      animation: quote-glow-soft 13s ease-in-out infinite alternate;
    }
  }

  @keyframes quote-glow-main {
    50% {
      transform: translate(-6%, 8%) scale(1.08);
      opacity: 0.9;
    }
    100% {
      transform: translate(-12%, 2%) scale(1.15);
      opacity: 1;
    }
  }

  @keyframes quote-glow-soft {
    to {
      transform: translate(-10%, -12%) scale(1.12);
    }
  }

  /* ---------- Open source ---------- */
  .open-source {
    margin-top: 80px;
    padding-top: 80px;
    padding-bottom: 80px;
    background: var(--ink-deep);
    color: var(--white);
  }

  .split-dark .split-text {
    max-width: 543px;
    color: rgba(255, 255, 255, 0.5);
  }

  .open-source .actions {
    margin-top: 32px;
  }

  .terminal {
    min-height: 439px;
    margin-top: 32px;
    border-radius: var(--radius-card);
    background: var(--navy);
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }

  .terminal-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 59px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 24px;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.5);
  }

  .terminal-bar img {
    position: absolute;
    left: 24px;
    top: 27px;
  }

  .terminal-body {
    padding: 38px 60px 60px;
    overflow-x: auto;
  }

  .terminal-body code {
    font-family: var(--font-mono);
    font-size: 18px;
    line-height: 24px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .prompt {
    color: var(--blue);
  }

  .terminal-lines {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 22px;
  }

  .terminal-lines span {
    display: block;
    max-width: 100%;
    height: 5px;
    background: linear-gradient(to right, rgba(255, 255, 255, 0), var(--white));
    opacity: 0.4;
  }

  /* Terminal types the command, then the output lines draw in */
  :global(.motion) .typed {
    display: inline-block;
    vertical-align: bottom;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    border-right: 2px solid transparent;
  }

  :global(.motion) .terminal:global(.in) .typed {
    animation:
      type 1.8s steps(57) 0.6s forwards,
      caret 0.7s step-end 0.6s 4;
  }

  :global(.motion) .terminal-lines span {
    transform: scaleX(0);
    transform-origin: left;
  }

  :global(.motion) .terminal:global(.in) .terminal-lines span {
    animation: draw-line 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  .terminal-lines span:nth-child(1) { animation-delay: 2.5s !important; }
  .terminal-lines span:nth-child(2) { animation-delay: 2.65s !important; }
  .terminal-lines span:nth-child(3) { animation-delay: 2.8s !important; }
  .terminal-lines span:nth-child(4) { animation-delay: 2.95s !important; }
  .terminal-lines span:nth-child(5) { animation-delay: 3.1s !important; }

  @keyframes type {
    to {
      width: calc(57 * (1ch - 0.02em));
    }
  }

  @keyframes caret {
    50% {
      border-right-color: var(--blue);
    }
  }

  @keyframes draw-line {
    to {
      transform: scaleX(1);
    }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 960px) {
    .services-grid,
    .case-grid {
      grid-template-columns: 1fr;
    }

    .case-head,
    .split {
      flex-direction: column;
      align-items: flex-start;
    }

    .big-stat {
      align-self: flex-end;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .steps p {
      margin-top: 8px;
    }
  }

  @media (max-width: 640px) {
    .mockup {
      display: none;
    }

    .testimonial,
    .quote {
      padding: 28px;
    }

    .ai-badge {
      position: relative;
      right: auto;
      bottom: auto;
      margin: -8px 0 16px -20px;
    }

    .service-card {
      display: flex;
      flex-direction: column-reverse;
    }

    .terminal-body {
      padding: 28px 24px 40px;
    }

    .terminal-body code {
      font-size: 14px;
    }
  }
</style>
