---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Orb from '../components/Orb.astro';
import StatsStrip from '../components/StatsStrip.astro';
import GlowBand from '../components/GlowBand.astro';
import { BOOK_CALL, GITHUB } from '../data/site';

const stats = [
  'Live in 2,000+ clinics, integrated with seven EMRs',
  'Open-source FHIR server, written in Rust, free on GitHub',
  'Founded 2016, Boston',
];

const steps = [
  { n: '01', text: 'Book a thirty-minute call with our founder and lead engineer, Steve.' },
  { n: '02', text: 'We’ll discuss your project and how we can help.' },
  { n: '03', text: 'If it’s a fit, we’ll put a plan in writing and get to work.' },
];
---

<Layout>
    <!-- Hero -->
    <section class="hero container">
      <p class="eyebrow">MEET HELIOS</p>
      <h1 class="heading-xl">
        <span class="dim">We build the healthcare software</span>{' '}you can’t afford to get wrong
      </h1>
      <p class="body-lg hero-lede">
        A senior engineering firm for healthcare technology leaders. We architected the platform
        behind one of the most widely deployed SMART on FHIR applications in the country.
      </p>
      <div class="actions actions-center">
        <Button href={BOOK_CALL} arrow>Book a call</Button>
        <Button href="#case-studies" variant="outline">See our work</Button>
      </div>

      <div class="hero-stats">
        <StatsStrip items={stats} cellWidth={290} />
      </div>
    </section>

    <!-- Problem statement -->
    <section class="statement rule-top">
      <div class="container">
        <span class="marker" aria-hidden="true"></span>
        <h2 class="heading-lg statement-text">
          <span class="dim">Healthcare technology leaders are being asked to</span>{' '}deliver more
          innovative software, adopt AI, and protect patient data, without drowning.
        </h2>
      </div>
    </section>

    <!-- Services -->
    <section class="services">
      <div class="container services-grid">
        <article class="card service-card">
          <img class="mockup" src="/figma/resources-mockup.png" alt="" loading="lazy" />
          <img class="card-sheen" src="/figma/card-sheen-1.svg" alt="" />
          <div class="service-copy">
            <h3>Software that makes it to production</h3>
            <p>
              We build new healthcare software and rescue what’s stalled. Systems that hold up
              under real patient data, delivered by engineers who have done it at scale.
            </p>
            <Button href={BOOK_CALL} arrow>Book a call</Button>
          </div>
        </article>

        <article class="card service-card">
          <img class="card-sheen" src="/figma/card-sheen-2.svg" alt="" />
          <div class="ai-badge" aria-hidden="true">
            <Orb class="ai-glow" />
            <Orb class="ai-orb" />
            <span class="ai-ring ai-ring-outer"></span>
            <span class="ai-ring ai-ring-inner"></span>
            <img class="ai-sparkle" src="/figma/sparkle.svg" alt="" width="16" height="16" />
          </div>
          <div class="service-copy">
            <h3>AI, put to work</h3>
            <p class="wide">
              We help healthcare organizations move AI from pilot to production: scoping where it
              holds up in clinical work, then building it into the systems your teams already use.
            </p>
            <Button href={BOOK_CALL} arrow>Book a call</Button>
          </div>
        </article>
      </div>
    </section>

    <!-- Case study -->
    <section id="case-studies" class="case container">
      <div class="case-head">
        <div>
          <h2 class="heading-lg case-title">
            <span class="dim-ink">From FHIR Strategy</span>{' '}to Production
          </h2>
          <p class="body-lg case-lede">
            For a prominent diagnostics company, we helped set the FHIR implementation strategy,
            staffed the initial engineering team, and did the hands-on development for a product
            that today runs in more than 2,000 clinics and is integrated with seven EMRs.
          </p>
        </div>
        <p class="big-stat">
          <span class="big-number">2,000+</span>
          <span class="big-label">Clinics</span>
        </p>
      </div>

      <div class="case-grid">
        <figure class="card testimonial">
          <blockquote>
            "Helios has transformed our clinic's operations. With seamless integration into our
            existing systems, we now serve over 2,000 patients daily without a hitch. The AI-driven
            insights have improved our patient care and streamlined workflows. We couldn't be
            happier with the results!"
          </blockquote>
          <figcaption>Dr. Sarah Thompson, Chief Medical Officer</figcaption>
        </figure>

        <div class="card photo">
          <img
            src="/figma/clinician.png"
            alt="A clinician at his desk reviewing work on a laptop"
            loading="lazy"
          />
          <Orb class="photo-glow" />
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="how rule-top">
      <div class="container">
        <h2 class="heading-lg">How it works</h2>
        <ol class="steps">
          {
            steps.map((s) => (
              <li>
                <span class="step-number">{s.n}</span>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- CTA: what it looks like when it works -->
    <GlowBand padTop={103} padBottom={102}>
        <h2 class="heading-lg">What it looks like when it works</h2>
        <p class="band-text works-text">
          The software is live. Clinicians use it without thinking about it, the integration holds
          through the next EHR upgrade, and the next board meeting opens with a demo of what's
          running and what customers are saying.
        </p>
        <Button href={BOOK_CALL} variant="dark" arrow>Book a call</Button>
    </GlowBand>

    <!-- Production -->
    <section class="split split-section container">
      <h2 class="heading-lg split-title">
        <span class="dim-light">Most healthcare software looks fine</span>{' '}in a demo.
      </h2>
      <p class="body-lg split-text">
        Production is where it gets hard: real patient data, clinical workflows that cannot pause
        for a bug, security review, integration engines nobody wants to touch. That is the
        environment we build for, and it is where our references come from. We made UTSW's
        VitalSign⁶ fully SMART on FHIR compatible, working directly with their team. When a client
        needed a working FHIR application for a major public demonstration, we delivered the first
        version in time. If your organization is carrying software it cannot afford to get wrong,
        we should talk.
      </p>
    </section>

    <section class="container">
      <figure class="card quote">
        <div class="quote-glow" aria-hidden="true">
          <img src="/figma/glow-yellow.svg" alt="" />
        </div>
        <blockquote class="heading-lg">
          <span class="dim-ink">“Healthcare's most valuable data has been sitting unused for decades.</span>{' '}That just changed.”
        </blockquote>
      </figure>
    </section>

    <!-- Open source -->
    <section id="open-source" class="open-source">
      <div class="container">
        <div class="split split-dark">
          <div>
            <h2 class="heading-lg">
              <span class="dim-white">We build</span>{' '}in the open.
            </h2>
            <div class="actions">
              <Button href={GITHUB} arrow>View on Github</Button>
              <Button href={GITHUB} variant="outline-dark">Explore the server</Button>
            </div>
          </div>
          <p class="body-lg split-text">
            The Helios FHIR Server is our open-source implementation of the HL7® FHIR® standard,
            written in Rust for performance and built for clinical analytics at scale. It supports
            FHIR R4 through R6 in a single system, with complete FHIRPath and SQL-on-FHIR engines,
            and deploys anywhere from a laptop to a production cluster. It is free, MIT-licensed,
            and public on GitHub.
          </p>
        </div>

        <div class="terminal">
          <div class="terminal-bar">
            <img src="/figma/terminal-dots.svg" alt="" width="32" height="8" />
            <span>[FHIR SERVER DEMO CAPTURE]</span>
          </div>
          <div class="terminal-body">
            <code><span class="prompt">$ </span>docker run -p 8080:8080 ghcr.io/heliossoftware/hfs:latest</code>
            <div class="terminal-lines" aria-hidden="true">
              <span style="width: 456px"></span>
              <span style="width: 579px"></span>
              <span style="width: 338px"></span>
              <span style="width: 579px"></span>
              <span style="width: 338px"></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA: what we put into production -->
    <GlowBand id="book-a-call" flipped padTop={121} padBottom={120}>
        <Orb class="band-orb" />
        <h2 class="heading-lg answer-title">
          <span class="dim-soft">What we put into production,</span>{' '}we answer for.
        </h2>
        <p class="band-text answer-text">
          We take a small number of engagements at a time. Thirty minutes with Steve will tell you
          whether we can help.
        </p>
        <Button href={BOOK_CALL} variant="dark" arrow>Book a call</Button>
    </GlowBand>

</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-top: 98px;
    padding-bottom: 80px;
    text-align: center;
  }

  .hero .eyebrow {
    margin-bottom: 24px;
  }

  .hero h1 {
    max-width: 624px;
    margin: 0 auto;
  }

  .hero-lede {
    max-width: 491px;
    margin: 24px auto;
  }

  .hero-stats {
    margin-top: 85px;
  }

  /* ---------- Statement ---------- */
  .statement .container {
    padding-top: 59px;
    padding-bottom: 80px;
  }

  .statement-text {
    max-width: 781px;
    margin-top: 24px;
  }

  /* ---------- Services ---------- */
  .services {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    padding-top: 79px;
    padding-bottom: 79px;
  }

  .service-copy p.wide {
    max-width: 423px;
  }

  .mockup {
    position: absolute;
    top: 37px;
    left: 71.3%;
    width: 493px;
    max-width: none;
  }

  .card-sheen {
    position: absolute;
    top: 0;
    left: -0.62%;
    width: 101.24%;
    height: 102.54%;
    max-width: none;
    pointer-events: none;
  }

  .ai-badge {
    position: absolute;
    right: 29px;
    bottom: 20px;
    width: 139px;
    height: 137px;
  }

  .ai-badge :global(.ai-glow) {
    left: 5px;
    top: 5px;
    width: 129px;
    height: 127px;
    filter: blur(27px);
    opacity: 0.67;
  }

  .ai-badge :global(.ai-orb) {
    left: 34.5px;
    top: 34px;
    width: 70px;
    height: 69px;
  }

  .ai-ring {
    position: absolute;
    border: 1px solid var(--white);
    border-radius: 1000px;
  }

  .ai-ring-outer {
    inset: 0;
    opacity: 0.2;
  }

  .ai-ring-inner {
    left: 17px;
    top: 17px;
    width: 104px;
    height: 103px;
    opacity: 0.4;
  }

  .ai-sparkle {
    position: absolute;
    left: 61.5px;
    top: 61px;
  }

  /* ---------- Case study ---------- */
  .case {
    padding-top: 60px;
    padding-bottom: 80px;
  }

  .case-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
  }

  .case-title {
    max-width: 426px;
    margin-top: 42px;
  }

  .case-lede {
    max-width: 531px;
    margin-top: 18px;
  }

  .big-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .big-number {
    font-weight: 500;
    font-size: clamp(88px, 12.8vw, 184px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .big-label {
    margin-top: -25px;
    font-size: clamp(24px, 2.43vw, 35px);
    line-height: 24px;
    letter-spacing: -0.02em;
    color: var(--muted);
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 32px;
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-height: 363px;
    padding: 39px;
    background: linear-gradient(to bottom, var(--white), var(--tint));
  }

  .testimonial blockquote {
    margin: 0;
    max-width: 491px;
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .testimonial figcaption {
    font-size: 17px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: rgba(16, 16, 16, 0.36);
  }

  .photo {
    min-height: 363px;
  }

  .photo > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo :global(.photo-glow) {
    left: 212px;
    top: -20px;
    width: 825px;
    height: 813px;
    filter: blur(47px);
    mix-blend-mode: hard-light;
  }

  /* ---------- How it works ---------- */
  .how .container {
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .steps {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .step-number {
    display: block;
    font-size: clamp(80px, 8.4vw, 121px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--blue);
  }

  .steps p {
    max-width: 364px;
    margin-top: 27px;
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  /* ---------- Gradient bands ---------- */
  .band-text {
    font-size: 18px;
    line-height: 24px;
    letter-spacing: -0.02em;
  }

  .works-text {
    max-width: 458px;
    margin: 24px 0;
  }

  :global(.orb.band-orb) {
    position: relative;
    width: 60.5px;
    height: 59.7px;
    margin-bottom: 16px;
  }

  .answer-title {
    max-width: 600px;
  }

  .answer-text {
    max-width: 491px;
    margin: 16px 0;
  }

  /* ---------- Split sections ---------- */
  .split {
    display: flex;
    justify-content: space-between;
    gap: 48px;
  }

  .split-section {
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .split-title {
    max-width: 491px;
  }

  .split-text {
    max-width: 578px;
  }

  .quote {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 363px;
    padding: 40px;
    background: linear-gradient(to bottom, var(--white), var(--tint));
    box-shadow: none;
    text-align: center;
  }

  .quote blockquote {
    position: relative;
    margin: 0;
    max-width: 629px;
  }

  .quote-glow {
    position: absolute;
    left: calc(100% - 253px);
    top: -346px;
    width: 472px;
    height: 472px;
  }

  .quote-glow img {
    position: absolute;
    inset: -105.93%;
    width: 311.86%;
    height: 311.86%;
    max-width: none;
  }

  /* ---------- Open source ---------- */
  .open-source {
    margin-top: 80px;
    padding-top: 80px;
    padding-bottom: 80px;
    background: var(--ink-deep);
    color: var(--white);
  }

  .split-dark .split-text {
    max-width: 543px;
    color: rgba(255, 255, 255, 0.5);
  }

  .open-source .actions {
    margin-top: 32px;
  }

  .terminal {
    min-height: 439px;
    margin-top: 32px;
    border-radius: var(--radius-card);
    background: var(--navy);
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }

  .terminal-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 59px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 24px;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.5);
  }

  .terminal-bar img {
    position: absolute;
    left: 24px;
    top: 27px;
  }

  .terminal-body {
    padding: 38px 60px 60px;
    overflow-x: auto;
  }

  .terminal-body code {
    font-family: var(--font-mono);
    font-size: 18px;
    line-height: 24px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .prompt {
    color: var(--blue);
  }

  .terminal-lines {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 22px;
  }

  .terminal-lines span {
    display: block;
    max-width: 100%;
    height: 5px;
    background: linear-gradient(to right, rgba(255, 255, 255, 0), var(--white));
    opacity: 0.4;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 960px) {
    .services-grid,
    .case-grid {
      grid-template-columns: 1fr;
    }

    .case-head,
    .split {
      flex-direction: column;
      align-items: flex-start;
    }

    .big-stat {
      align-self: flex-end;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .steps p {
      margin-top: 8px;
    }
  }

  @media (max-width: 640px) {
    .mockup {
      display: none;
    }

    .testimonial,
    .quote {
      padding: 28px;
    }

    .ai-badge {
      position: relative;
      right: auto;
      bottom: auto;
      margin: -8px 0 16px -20px;
    }

    .service-card {
      display: flex;
      flex-direction: column-reverse;
    }

    .photo {
      min-height: 280px;
    }

    .terminal-body {
      padding: 28px 24px 40px;
    }

    .terminal-body code {
      font-size: 14px;
    }
  }
</style>
