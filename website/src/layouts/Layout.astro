---
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/500.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/500.css';
import '@fontsource/ibm-plex-mono/400.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Helios Software',
  description = 'A senior engineering firm for healthcare technology leaders. We build the healthcare software you can’t afford to get wrong.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Colors from the Figma design */
    --blue: #33b8ff;
    --blue-strong: #12a8f7;
    --ink: #101010;
    --ink-deep: #000f17;
    --navy: #001b2a;
    --muted: rgba(0, 15, 23, 0.5);
    --border: #eaeaea;
    --border-soft: #e8e8e8;
    --surface: #f5f5f5;
    --tint: #e9f7ff;
    --white: #ffffff;

    --font-sans: 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-ui: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

    --max: 1440px;
    --gutter: clamp(16px, 4.17vw, 60px);
    --section-gap: clamp(48px, 5.6vw, 80px);
    --radius-card: 16px;
    --radius-button: 12px;
    --card-shadow: 0 4px 4px rgba(0, 0, 0, 0.03);

    font-family: var(--font-sans);
    color: var(--ink);
    background: var(--white);
    -webkit-font-smoothing: antialiased;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--white);
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .container {
    max-width: var(--max);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  /* Type scale from the design */
  .heading-xl {
    font-weight: 500;
    font-size: clamp(36px, 3.82vw, 55px);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .heading-lg {
    font-weight: 500;
    font-size: clamp(30px, 3.06vw, 44px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .body-lg {
    font-size: 18px;
    line-height: 24px;
    letter-spacing: -0.02em;
    color: var(--muted);
  }

  .dim {
    color: var(--muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
