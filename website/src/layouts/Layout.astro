---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Helios FHIR Server',
  description = 'A high-performance HL7® FHIR® server built in Rust, optimized for clinical analytics.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --surface: #f6f7f9;
    --text: #0f172a;
    --muted: #475569;
    --border: #e2e8f0;
    --accent: #f59e0b;
    --accent-ink: #1c1917;
    --code-bg: #0f172a;
    --code-text: #e2e8f0;
    --max: 1120px;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: var(--text);
    background: var(--bg);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0b1120;
      --surface: #111a2e;
      --text: #e2e8f0;
      --muted: #94a3b8;
      --border: #1e293b;
      --code-bg: #020617;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    line-height: 1.6;
  }

  a {
    color: inherit;
  }

  .container {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 16px;
  }
</style>
